<odoo>
    <record id="view_users_tree" model="ir.ui.view">
        <field name="name">auth_impersonate_user.view_users_tree</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='role']" position="after">
                <button
                    name="impersonate_user"
                    string="Impersonate"
                    type="object"
                    class="oe_highlight"
                    groups="auth_impersonate_user.impersonate_admin_group"
                    invisible="not can_be_impersonated"
                />
            </xpath>
        </field>
    </record>

    <record id="view_users_form" model="ir.ui.view">
        <field name="name">auth_impersonate_user.view_users_form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="impersonate_user"
                    invisible="not can_be_impersonated or not can_impersonate_user"
                    string="Impersonate"
                    type="object"
                />
            </xpath>
        </field>
    </record>
</odoo>
