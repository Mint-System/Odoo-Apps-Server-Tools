<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="test_bus_model_form_view" model="ir.ui.view">
        <field name="name">test_bus.test_bus_model_form_view</field>
        <field name="model">test.bus.model</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_trigger_bus" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-bell">
                            <field name="counter" widget="statinfo" string="Counter"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Enter name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="test_bus_model_list_view" model="ir.ui.view">
        <field name="name">test_bus.test_bus_model_list_view</field>
        <field name="model">test.bus.model</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="counter"/>
            </list>
        </field>
    </record>

    <record id="action_test_bus_model" model="ir.actions.act_window">
        <field name="name">Test Bus Model</field>
        <field name="res_model">test.bus.model</field>
        <field name="view_mode">list,form</field>
    </record>



    <menuitem id="menu_test_bus_root"
              name="Test Bus"
              sequence="100"/>

    <menuitem id="menu_test_bus_model"
              name="Test Bus Models"
              parent="menu_test_bus_root"
              action="action_test_bus_model"
              sequence="10"/>

</odoo>
